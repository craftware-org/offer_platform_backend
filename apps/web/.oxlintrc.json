{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "jsx-a11y",
    "nextjs"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/no-danger": "error",
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": [
    ".next/**",
    "next-env.d.ts"
  ]
}
