# Copy to apps/api/.env for local development:  cp .env.example .env
# Never commit .env. Staging/production values come from the deployment environment (AWS), not files.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Number of proxies in front of the app (1 behind an AWS load balancer, 0 locally)
TRUST_PROXY_HOPS=0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Brand is configuration (ADR-0009); the product name is not final
APP_DISPLAY_NAME=Offer Platform
APP_PUBLIC_URL=https://offer-platform.example

# Matches docker-compose.yml (local only)
DATABASE_URL=postgres://offer_platform:offer_platform_dev@localhost:5432/offer_platform
REDIS_URL=redis://localhost:6379

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_HASH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
DEFAULT_PHONE_COUNTRY=IN

# `console` prints OTPs to the server log (development only). Real vendor: pending decision.
SMS_PROVIDER=console

RATE_LIMIT_PER_IP_PER_MINUTE=300

# Future features: keep false for the MVP
MONETIZATION_ENABLED=false
BUSINESS_SUBSCRIPTIONS_ENABLED=false
CUSTOMER_SUBSCRIPTIONS_ENABLED=false
SPONSORED_OFFERS_ENABLED=false
QR_REDEMPTION_ENABLED=false
REVIEWS_ENABLED=false
REWARDS_ENABLED=false
AI_RECOMMENDATIONS_ENABLED=false
