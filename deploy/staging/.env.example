# Staging/preview server configuration. setup-server.sh copies this to .env and fills every
# <generated> value with a random secret ON THE SERVER. Never commit the real .env.

NODE_ENV=staging
PREVIEW_MODE=true
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

APP_DISPLAY_NAME=Dodoom
APP_PUBLIC_URL=https://dodoom.vercel.app
CORS_ORIGINS=https://dodoom.vercel.app

# Public hostname Caddy serves (HTTPS). With no domain yet: <elastic-ip-with-dashes>.sslip.io
API_DOMAIN=<set by setup-server.sh>

POSTGRES_PASSWORD=<generated>
DATABASE_URL=postgres://offer_platform:<same as POSTGRES_PASSWORD>@postgres:5432/offer_platform
REDIS_URL=redis://valkey:6379

JWT_ACCESS_SECRET=<generated>
OTP_HASH_SECRET=<generated>

# Phone codes go to the server log until an SMS vendor is chosen (allowed only in PREVIEW_MODE).
SMS_PROVIDER=console

# Email codes via Gmail. The App Password is entered with ./set-secret.sh SMTP_PASSWORD (hidden prompt).
# Until it is set, EMAIL_PROVIDER stays console (codes in the server log).
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=craftwaretech@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=Dodoom <craftwaretech@gmail.com>

# Images on the server disk (Docker volume) while in preview; S3 before public launch.
STORAGE_PROVIDER=local

# Future features: keep false for the MVP
MONETIZATION_ENABLED=false
BUSINESS_SUBSCRIPTIONS_ENABLED=false
CUSTOMER_SUBSCRIPTIONS_ENABLED=false
SPONSORED_OFFERS_ENABLED=false
QR_REDEMPTION_ENABLED=false
REVIEWS_ENABLED=false
REWARDS_ENABLED=false
AI_RECOMMENDATIONS_ENABLED=false
